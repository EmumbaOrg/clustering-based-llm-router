-// convertIOPMapValues converts certain paths of map[string]string values into string.
+// shouldKeepAsString determines whether a set flag value should be preserved as a string.
+func shouldKeepAsString(iop map[string]any, path util.Path) bool {
+	if len(path) == 0 {
+		return false
+	}
+
+	if node, found, err := tpath.Find(iop, path); err == nil && found {
+		if _, ok := node.(string); ok {
+			return true
+		}
+	}
+
+	if len(path) >= 4 && path[len(path)-3] == "resources" &&
+		(path[len(path)-2] == "limits" || path[len(path)-2] == "requests") {
+		return true
+	}
+
+	if len(path) < 2 {
+		return false
+	}
+	parent, found, err := tpath.Find(iop, path[:len(path)-1])
+	if err != nil || !found {
+		return false
+	}
+
+	return mapHasOnlyStringValues(parent)
+}
+
+// mapHasOnlyStringValues reports whether every value in the map is a string.
+func mapHasOnlyStringValues(node any) bool {
+	v := reflect.ValueOf(node)
+	if !v.IsValid() || v.Kind() != reflect.Map || v.Len() == 0 {
+		return false
+	}
+	for _, key := range v.MapKeys() {
+		if _, ok := v.MapIndex(key).Interface().(string); !ok {
+			return false
+		}
+	}
+	return true
+}
