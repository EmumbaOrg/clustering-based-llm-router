+        private static @CheckForNull ImmutableCollectionKind getImmutableCollectionKind(@CheckForNull String signature) {
+            if (signature == null || signature.isEmpty() || signature.charAt(0) != 'L') {
+                return null;
+            }
+            String className = ClassName.fromFieldSignatureToDottedClassName(signature);
+            if (className.startsWith("java.util.Collections$") || className.startsWith("java.util.ImmutableCollections$")) {
+                if (className.contains("List")) {
+                    return ImmutableCollectionKind.LIST;
+                }
+                if (className.contains("Map")) {
+                    return ImmutableCollectionKind.MAP;
+                }
+                if (className.contains("Set")) {
+                    return ImmutableCollectionKind.SET;
+                }
+            }
+            return null;
+        }
+
+        private static boolean isImmutableCollectionMerge(Item i1, Item i2) {
+            ImmutableCollectionKind kind1 = getImmutableCollectionKind(i1.signature);
+            ImmutableCollectionKind kind2 = getImmutableCollectionKind(i2.signature);
+            return kind1 != null && kind1 == kind2;
+        }
