+    _re_conditional_tag = re.compile(
+        r"^(\s*\{%\s*[+\-]?\s*(?:if|elif)\s+)(.*?)(\s*[+\-]?\s*%\}\s*)$",
+        re.DOTALL,
+    )
+
+    @classmethod
+    def _rewrite_conditional_tag(cls, raw_tag: str, value: bool) -> str:
+        """Replace the condition inside a Jinja if/elif tag."""
+        match = cls._re_conditional_tag.match(raw_tag)
+        if not match:
+            return raw_tag
+        return f"{match.group(1)}{'True' if value else 'False'}{match.group(3)}"
+
+    @staticmethod
+    def _apply_raw_replacements(
+        raw_str: str,
+        raw_sliced: List[RawFileSlice],
+        replacements: Dict[int, str],
+    ) -> str:
+        """Apply replacements for raw slices to a template string."""
+        if not replacements:
+            return raw_str
+        parts: List[str] = []
+        last_idx = 0
+        for slice_idx, replacement in sorted(replacements.items()):
+            raw_slice = raw_sliced[slice_idx]
+            parts.append(raw_str[last_idx : raw_slice.source_idx])
+            parts.append(replacement)
+            last_idx = raw_slice.end_source_idx()
+        parts.append(raw_str[last_idx:])
+        return "".join(parts)
+
