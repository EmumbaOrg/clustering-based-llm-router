+    let status = new ParseStatus();
+    let ctx: undefined | ParseContext = undefined;
+
+    for (const check of this._def.checks) {
+      if (check.kind === "min") {
+        if (input.data.getTime() < check.value.getTime()) {
+          ctx = this._getOrReturnCtx(input, ctx);
+          addIssueToContext(ctx, {
+            code: ZodIssueCode.too_small,
+            minimum: check.value,
+            type: "date",
+            inclusive: true,
+            message: check.message,
+          });
+          status.dirty();
+        }
+      } else if (check.kind === "max") {
+        if (input.data.getTime() > check.value.getTime()) {
+          ctx = this._getOrReturnCtx(input, ctx);
+          addIssueToContext(ctx, {
+            code: ZodIssueCode.too_big,
+            maximum: check.value,
+            type: "date",
+            inclusive: true,
+            message: check.message,
+          });
+          status.dirty();
+        }
+      } else {
+        util.assertNever(check);
+      }
+    }
+
+    return { status: status.value, value: new Date(input.data.getTime()) };
+  }
+
+  min(minDate: Date, message?: errorUtil.ErrMessage) {
+    return new ZodDate({
+      ...this._def,
+      checks: [
+        ...this._def.checks,
+        { kind: "min", value: minDate, message: errorUtil.toString(message) },
+      ],
+    });
+  }
+
+  max(maxDate: Date, message?: errorUtil.ErrMessage) {
+    return new ZodDate({
+      ...this._def,
+      checks: [
+        ...this._def.checks,
+        { kind: "max", value: maxDate, message: errorUtil.toString(message) },
+      ],
+    });
   }
 
   static create = (params?: RawCreateParams): ZodDate => {
     return new ZodDate({
+      checks: [],
       typeName: ZodFirstPartyTypeKind.ZodDate,
       ...processCreateParams(params),
     });
