+func localizedDateFormat(p Page, t time.Time, format string) string {
+	if site := p.Site(); site != nil {
+		if l := site.Language(); l != nil {
+			if translator := langs.GetTranslator(l); translator != nil {
+				return htime.NewTimeFormatter(translator).Format(t, format)
+			}
+		}
+	}
+
+	return t.Format(format)
+}
