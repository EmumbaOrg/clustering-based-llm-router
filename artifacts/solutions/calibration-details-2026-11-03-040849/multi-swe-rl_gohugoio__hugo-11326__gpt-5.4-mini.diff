+
+const remoteRequestMaxAttempts = 4
+
+func isRetryableRemoteMethod(method string) bool {
+	switch method {
+	case http.MethodGet, http.MethodHead:
+		return true
+	default:
+		return false
+	}
+}
+
+func isRetryableRemoteStatus(status int) bool {
+	switch status {
+	case http.StatusRequestTimeout,
+		http.StatusTooManyRequests,
+		http.StatusInternalServerError,
+		http.StatusBadGateway,
+		http.StatusServiceUnavailable,
+		http.StatusGatewayTimeout:
+		return true
+	default:
+		return false
+	}
+}
+
+func isTemporaryRemoteError(err error) bool {
+	var ne net.Error
+	if !errors.As(err, &ne) {
+		return false
+	}
+	return ne.Timeout() || ne.Temporary()
+}
+
+func remoteRequestRetryDelay(attempt int, res *http.Response) time.Duration {
+	delay := 200 * time.Millisecond
+	for i := 1; i < attempt; i++ {
+		delay *= 2
+	}
+
+	if res == nil {
+		return delay
+	}
+
+	if retryAfter := res.Header.Get("Retry-After"); retryAfter != "" {
+		if secs, err := strconv.Atoi(retryAfter); err == nil && secs > 0 {
+			retryAfterDelay := time.Duration(secs) * time.Second
+			if retryAfterDelay > delay {
+				return retryAfterDelay
+			}
+			return delay
+		}
+
+		if retryAfterTime, err := http.ParseTime(retryAfter); err == nil {
+			retryAfterDelay := time.Until(retryAfterTime)
+			if retryAfterDelay > delay {
+				return retryAfterDelay
+			}
+		}
+	}
+
+	return delay
+}
