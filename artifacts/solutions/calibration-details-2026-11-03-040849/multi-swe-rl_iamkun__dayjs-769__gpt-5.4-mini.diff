+const isLeapYear = year => (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0
+
+const firstWeekOffset = (year, weekStart, yearStart) => {
+  const fwd = 7 + weekStart - yearStart
+  const fwdDate = new Date(year, 0, fwd)
+  const fwdlw = (7 + fwdDate.getDay() - weekStart) % 7
+  return -fwdlw + fwd - 1
+}
+
+const weeksInYear = (year, weekStart, yearStart) => {
+  const weekOffset = firstWeekOffset(year, weekStart, yearStart)
+  const weekOffsetNext = firstWeekOffset(year + 1, weekStart, yearStart)
+  return (isLeapYear(year) ? 366 : 365) - weekOffset + weekOffsetNext
+}
 
