+func resolveGoWorkUseDirs(fs afero.Fs, workspaceFilename string) []string {
+	if workspaceFilename == "" || workspaceFilename == "off" {
+		return nil
+	}
+
+	f, err := fs.Open(workspaceFilename)
+	if err != nil {
+		return nil
+	}
+	defer f.Close()
+
+	baseDir := filepath.Dir(workspaceFilename)
+	seen := make(map[string]bool)
+	var dirs []string
+	inUseBlock := false
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := scanner.Text()
+		if idx := strings.Index(line, "//"); idx >= 0 {
+			line = line[:idx]
+		}
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+
+		if inUseBlock {
+			if line == ")" {
+				inUseBlock = false
+				continue
+			}
+		} else if line == "use (" {
+			inUseBlock = true
+			continue
+		} else if !strings.HasPrefix(line, "use ") {
+			continue
+		}
+
+		if strings.HasPrefix(line, "use ") {
+			line = strings.TrimSpace(strings.TrimPrefix(line, "use"))
+		}
+
+		line = strings.Trim(line, `"`)
+		if line == "" {
+			continue
+		}
+
+		if !filepath.IsAbs(line) {
+			line = filepath.Clean(filepath.Join(baseDir, line))
+		}
+
+		if !seen[line] {
+			seen[line] = true
+			dirs = append(dirs, line)
+		}
+	}
+
+	return dirs
+}
