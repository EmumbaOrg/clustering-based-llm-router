+func TestMaxMin(t *testing.T) {
+	t.Parallel()
+	c := qt.New(t)
+
+	ns := New()
+
+	for _, test := range []struct {
+		fn     func(a, b interface{}) (float64, error)
+		a      interface{}
+		b      interface{}
+		expect interface{}
+	}{
+		{ns.Max, 1, 2, 2.0},
+		{ns.Max, 1.5, 1.2, 1.5},
+		{ns.Min, 1, 2, 1.0},
+		{ns.Min, 1.5, 1.2, 1.2},
+		{ns.Max, 1, "foo", false},
+		{ns.Min, "foo", 1, false},
+	} {
+		result, err := test.fn(test.a, test.b)
+
+		if b, ok := test.expect.(bool); ok && !b {
+			c.Assert(err, qt.Not(qt.IsNil))
+			continue
+		}
+
+		c.Assert(err, qt.IsNil)
+		c.Assert(result, qt.Equals, test.expect)
+	}
+}
