+// Max returns the larger of x or y.
+func (ns *Namespace) Max(x, y interface{}) (float64, error) {
+	xf, err := cast.ToFloat64E(x)
+	if err != nil {
+		return 0, errors.New("Max operator can't be used with non-float value")
+	}
+
+	yf, err := cast.ToFloat64E(y)
+	if err != nil {
+		return 0, errors.New("Max operator can't be used with non-float value")
+	}
+
+	return math.Max(xf, yf), nil
+}
+
+// Min returns the smaller of x or y.
+func (ns *Namespace) Min(x, y interface{}) (float64, error) {
+	xf, err := cast.ToFloat64E(x)
+	if err != nil {
+		return 0, errors.New("Min operator can't be used with non-float value")
+	}
+
+	yf, err := cast.ToFloat64E(y)
+	if err != nil {
+		return 0, errors.New("Min operator can't be used with non-float value")
+	}
+
+	return math.Min(xf, yf), nil
+}
