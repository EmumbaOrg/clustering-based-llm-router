+function getCustomProperties(style: CSSStyleDeclaration) {
+  const res: Record<string, string> = {}
+  for (let i = 0; i < style.length; i++) {
+    const name = style[i]
+    if (name.startsWith('--')) {
+      res[name] = style.getPropertyValue(name)
+    }
+  }
+  return res
+}
+
+function getCustomPropertiesFromValue(style: Style) {
+  const res = new Set<string>()
+  if (!style) {
+    return res
+  }
+  if (isString(style)) {
+    customPropRE.lastIndex = 0
+    let match
+    while ((match = customPropRE.exec(style))) {
+      res.add(match[1])
+    }
+  } else {
+    for (const key in style) {
+      if (key.startsWith('--')) {
+        res.add(key)
+      }
+    }
+  }
+  return res
+}
+
+const customPropRE = /(?:^|;)\s*(--[^:\s;]+)\s*:/g
+
 const semicolonRE = /[^\\];\s*$/
